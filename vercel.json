{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "hulyastudio.com" }],
      "destination": "https://www.hulyastudio.com",
      "statusCode": 301
    },
    {
      "source": "/:path+",
      "has": [{ "type": "host", "value": "hulyastudio.com" }],
      "destination": "https://www.hulyastudio.com/:path+",
      "statusCode": 301
    },
    {
      "source": "/tokat-rofle",
      "destination": "/tokat-ombre",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/((?!sitemap.xml|robots.txt|favicon.svg|images|videos|assets).*)",
      "destination": "/index.html"
    }
  ]
}
